{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/source-disposition.schema.json",
  "title": "Source Disposition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["unit_id", "status"],
  "properties": {
    "unit_id": {"type": "string", "minLength": 1},
    "status": {"type": "string",
               "enum": ["requirement", "background", "duplicate",
                        "approved_exclusion", "conflict", "parse_uncertain",
                        "unreviewed"]},
    "requirement_ids": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string"}
  }
}
