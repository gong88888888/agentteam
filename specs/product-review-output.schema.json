{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/product-review-output.schema.json",
  "title": "Product Review Role Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "role", "status", "source_sections", "findings", "coverage", "files", "summary", "open_questions"],
  "properties": {
    "task_id": {"type": "string"},
    "role": {"type": "string"},
    "status": {"type": "string", "enum": ["done", "need_evidence", "blocked"]},
    "source_sections": {"type": "array", "items": {"type": "string"}},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "claim", "source_refs", "recommendation"],
        "properties": {
          "id": {"type": "string"},
          "severity": {"type": "string", "enum": ["info", "minor", "major", "critical"]},
          "claim": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "recommendation": {"type": "string"}
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_sections", "covered_sections"],
      "properties": {
        "total_sections": {"type": "integer", "minimum": 0},
        "covered_sections": {"type": "integer", "minimum": 0},
        "percent": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": {"type": "string"},
          "content": {"type": "string"}
        }
      }
    },
    "summary": {"type": "string"},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
