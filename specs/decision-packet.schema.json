{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/decision-packet.schema.json",
  "title": "Judge Decision Packet v1",
  "description": "修复建议1 P0-1 / P1-7：裁判只看结构化决策包；Agent 自述标记为 claim。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packet_id",
    "gate_id",
    "decision_type",
    "scope",
    "baseline_versions",
    "baseline_fp",
    "subject_hash",
    "inputs",
    "deterministic_checks",
    "missing_evidence",
    "acceptance",
    "diff",
    "risk",
    "worker_claims",
    "policy_refs",
    "budget",
    "content_isolation",
    "packet_hash"
  ],
  "properties": {
    "packet_id": { "type": "string" },
    "gate_id": { "type": "string" },
    "decision_type": {
      "type": "string",
      "enum": ["gate", "project_close", "option_selection"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "slice", "risk"],
      "properties": {
        "project": { "type": "string" },
        "slice": { "type": "string" },
        "risk": { "type": "string" }
      }
    },
    "baseline_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "baseline_fp": { "type": "string" },
    "subject_hash": { "type": "string" },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "signed_by"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" },
          "signed_by": { "type": "string" }
        }
      }
    },
    "deterministic_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "result", "tool", "tool_version", "signed_by"],
        "properties": {
          "evidence_id": { "type": "string" },
          "kind": { "type": "string" },
          "result": { "type": "string", "enum": ["pass", "fail"] },
          "tool": { "type": "string" },
          "tool_version": { "type": "string" },
          "signed_by": { "type": "string", "pattern": "^tool:" }
        }
      }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "acceptance": {
      "type": "array",
      "items": { "type": "string" }
    },
    "diff": { "type": "object" },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "factors"],
      "properties": {
        "level": { "type": "string" },
        "factors": { "type": "array", "items": { "type": "string" } }
      }
    },
    "worker_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "signed_by", "counts_as_evidence"],
        "properties": {
          "claim": { "type": "string" },
          "signed_by": { "type": "string" },
          "counts_as_evidence": { "const": false }
        }
      }
    },
    "policy_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "budget": { "type": "object" },
    "content_isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sanitized", "instruction_like_blocks"],
      "properties": {
        "sanitized": { "type": "boolean" },
        "instruction_like_blocks": { "type": "integer", "minimum": 0 }
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "cost", "risk", "reversible"],
        "properties": {
          "id": { "type": "string" },
          "summary": { "type": "string" },
          "cost": { "type": "string" },
          "risk": { "type": "string" },
          "reversible": { "type": "boolean" }
        }
      }
    },
    "packet_hash": { "type": "string" }
  }
}
