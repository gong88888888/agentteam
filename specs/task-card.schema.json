{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentteam.local/schemas/task-card.schema.json",
  "title": "Task Card v2",
  "description": "修复建议1 P0-2/P0-3：任务卡必须包含预算、重试、幂等、锁、提示词版本等机器可校验字段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "project_id",
    "slice_id",
    "owner_role",
    "status",
    "deps",
    "deps_any",
    "input_refs",
    "baseline_versions",
    "output_contract",
    "acceptance_ids",
    "risk",
    "write_scope",
    "locks",
    "evidence_required",
    "budget",
    "retry",
    "prompt_version",
    "idempotency_key",
    "rollback_scope"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "project_id": { "type": "string" },
    "slice_id": { "type": "string" },
    "owner_role": {
      "type": "string",
      "enum": [
        "pm", "product", "ui", "arch", "frontend", "backend",
        "review", "qa", "security", "ops", "kb", "retro"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "待就绪", "就绪", "确定性检查中", "待裁判", "执行中",
        "通过", "已合入", "定向整改", "失败", "阻塞", "已被复评取代"
      ]
    },
    "deps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "deps_any": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    },
    "input_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "hash"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "baseline_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "artifacts"],
      "properties": {
        "schema": { "type": "string", "pattern": "\\.json$" },
        "artifacts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "acceptance_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "drivers"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "drivers": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "write_scope": {
      "type": "array",
      "items": { "type": "string" }
    },
    "locks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_required": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "subject", "must_pass"],
        "properties": {
          "kind": { "type": "string" },
          "subject": { "type": "string" },
          "must_pass": { "type": "boolean" }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_tokens", "max_usd", "max_minutes"],
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 1000 },
        "max_usd": { "type": "number", "minimum": 0 },
        "max_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "backoff", "on_exhaust"],
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
        "backoff": { "type": "string", "enum": ["none", "linear", "exponential"] },
        "on_exhaust": { "type": "string", "enum": ["blocked", "failed"] }
      }
    },
    "prompt_version": { "type": "string" },
    "idempotency_key": { "type": "string" },
    "decision_id": { "type": ["string", "null"] },
    "rollback_scope": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
