# 复制为 .env 后填写；.env 必须加入 .gitignore，禁止提交。
# 裁判与执行模型的密钥分开，执行 Agent 不可读取裁判密钥。

# 本地模型（Ollama）
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen3.6:35b-a3b-mtp-q4_K_M
LOCAL_FALLBACK_MODEL=qwen3.5:9b-q4_K_M

# DeepSeek / deepseekharness（J1/J3 裁判与执行 Agent 的补充）
DEEPSEEK_HARNESS_URL=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

# J2 第二模型家族（默认使用本地 Qwen；如换其他家族在此配置）
SECOND_JUDGE_BASE_URL=
SECOND_JUDGE_API_KEY=
SECOND_JUDGE_MODEL=

# 证据/裁决签名密钥；不设置时会在 .agentteam/signing.key 本地生成
EVIDENCE_SIGNING_KEY=
